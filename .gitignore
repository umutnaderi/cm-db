# Raw audio source library (146 WAV files, ~155MB, mostly uncompressed
# PCM) -- source material for tools/convert-sounds.mjs, never committed
# itself. sounds/v1/ (the small compressed output) is NOT excluded.
sounds/*.wav

# Local test run logs
.test-*-output.txt
